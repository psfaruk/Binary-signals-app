# ════════════════════════════════════════════════════════════════════════════
# Binary Signals App — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# ⚠️  SIMULATION MODE IS PERMANENTLY DISABLED (2026-07-25).
# The app now REQUIRES live Quotex credentials. sim_feed.py has been
# renamed to sim_feed.py.DISABLED and is no longer imported.
#
# If QX_TOKEN is missing, the server will still start (so /api/set-token
# is reachable to provision a token at runtime) but ALL stream
# subscriptions will return errors until a token is provided.
#
# Copy this file to `.env` for local dev:    cp .env.example .env
# On Railway: set these in the Variables tab (do NOT commit a .env file).
# ════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED: Quotex Token ─────────────────────────────────────────────────
# Extract from your browser's DevTools after logging into Quotex:
#   1. Open https://quotex.com → log in
#   2. F12 → Network tab → reload page
#   3. Filter by "authorization"
#   4. Click the request → Payload tab
#   5. Copy the value of the "session" field
#
# Token expires ~24 hours. Refresh via:
#   - Railway Variables (manual update)
#   - /api/set-token?token=NEW_TOKEN (browser URL)
#   - POST /api/set-token with JSON body {"token": "NEW_TOKEN"}
#   - scripts/setup_railway_token.py (Railway API auto-push, see RAILWAY_TOKEN_SETUP.md)
QX_TOKEN=

# ─── IGNORED: USE_SIM ───────────────────────────────────────────────────────
# USE_SIM is now IGNORED — sim mode is permanently disabled.
# Setting USE_SIM=1 has no effect; the app will log a warning and continue
# in live-data-only mode.
USE_SIM=0

# ─── OPTIONAL: Email/Password (LOCAL DEV ONLY) ──────────────────────────────
# Cloudflare blocks email/password login from Railway datacenter IPs.
# Use this only for local development. Railway deployments MUST use QX_TOKEN.
QX_EMAIL=
QX_PASSWORD=

# ─── BACKEND SELECTION ──────────────────────────────────────────────────────
# QX_USE_RAW_WS=0   # DEFAULT — vendored pyquotex with Firefox TLS cipher
#                   #            suite (bypasses Cloudflare without
#                   #            Playwright/curl_cffi). Recommended.
# QX_USE_RAW_WS=1   # raw WebSocket backend (quotex_ws.py) — lighter but
#                   #            Cloudflare blocks login on datacenter IPs.
QX_USE_RAW_WS=0

# ─── LIVE RE-EVAL (CALIBRATION-2026-07-29) ─────────────────────────────────
# Data analysis of 1,325 graded signals showed LIVE re-eval was the #1
# accuracy killer: 88% of signals had confidence reduced to 15 via
# "RECOVERED_CONFIDENCE" path, and these signals had only 43.3% win rate
# (vs 99%+ for non-recovered signals).
# QX_DISABLE_LIVE_REEVAL=1  # DEFAULT — disable LIVE re-eval (recommended)
# QX_DISABLE_LIVE_REEVAL=0  # enable LIVE re-eval (legacy behavior, NOT recommended)
QX_DISABLE_LIVE_REEVAL=1

# ─── PAYOUT FLOORS ──────────────────────────────────────────────────────────
# Real forex market: open 5 days/week (Mon-Fri). Closed Sat/Sun.
# OTC pairs: open 24/7/365 (broker-generated, always live).
# Real pairs below 70% payout are filtered out; OTC pairs below 85% are filtered.
QX_PAYOUT_FLOOR_REAL=70
QX_PAYOUT_FLOOR_OTC=85

# ─── DEPLOYMENT MODE (Railway) ──────────────────────────────────────────────
# Railway has no GUI — these must be set.
AUTO_OPEN_BROWSER=0
HEADLESS=1

# ─── RAILWAY AUTO-SETUP (optional) ──────────────────────────────────────────
# These are used by scripts/setup_railway_token.py to programmatically
# push a fresh QX_TOKEN to Railway Variables (instead of clicking the dashboard).
# Get the API token from: https://railway.app/account/tokens
# Run `python3 scripts/setup_railway_token.py --list` to find project/service IDs.
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=
