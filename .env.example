# ════════════════════════════════════════════════════════════════════════════
# Binary Signals App — Environment Variables
# ════════════════════════════════════════════════════════════════════════════
#
# ⚠️  SIMULATION MODE IS PERMANENTLY DISABLED (2026-07-25).
# The app now REQUIRES live Quotex credentials. sim_feed.py has been
# renamed to sim_feed.py.DISABLED and is no longer imported.
#
# If QX_TOKEN is missing, the server will still start (so /api/set-token
# is reachable to provision a token at runtime) but ALL stream
# subscriptions will return errors until a token is provided.
#
# Copy this file to `.env` for local dev:    cp .env.example .env
# On Railway: set these in the Variables tab (do NOT commit a .env file).
# ════════════════════════════════════════════════════════════════════════════

# ─── REQUIRED: Quotex Token ─────────────────────────────────────────────────
# Extract from your browser's DevTools after logging into Quotex:
#   1. Open https://quotex.com → log in
#   2. F12 → Network tab → reload page
#   3. Filter by "authorization"
#   4. Click the request → Payload tab
#   5. Copy the value of the "session" field
#
# Token expires ~24 hours. Refresh via:
#   - Railway Variables (manual update)
#   - /api/set-token?token=NEW_TOKEN (browser URL)
#   - POST /api/set-token with JSON body {"token": "NEW_TOKEN"}
#   - scripts/setup_railway_token.py (Railway API auto-push, see RAILWAY_TOKEN_SETUP.md)
QX_TOKEN=

# ─── IGNORED: USE_SIM ───────────────────────────────────────────────────────
# USE_SIM is now IGNORED — sim mode is permanently disabled.
# Setting USE_SIM=1 has no effect; the app will log a warning and continue
# in live-data-only mode.
USE_SIM=0

# ─── AUTO-SESSION: the app mints its own tokens ─────────────────────────────
# QX_TOKEN above expires ~24h. Rather than paste a new one every day, give the
# app the browser cookies that keep YOU logged in — core/qx_session.py replays
# them against https://<QX_WEB_HOST>/en/trade and reads a fresh SSID out of
# `window.settings.token`. That is a plain authenticated GET, i.e. exactly what
# a browser tab does, so it neither trips Cloudflare nor looks like the
# repeated form-POST abuse that got this account blocked once before.
#
# HOW TO GET THEM (once):
#   1. Log in to Quotex in your browser.
#   2. F12 → Console → run:  copy(document.cookie)
#   3. Paste into the app's 🔑 Token panel → "Session cookies" (no redeploy),
#      or into QX_COOKIES below.
#
# The ONE cookie that matters is `remember_web_<sha1>` — Laravel's "keep me
# logged in" recaller. Without it the trade page returns the signed-out HTML
# with HTTP 200 and no token.
QX_COOKIES=
# …or supply them individually instead of the whole blob:
QX_REMEMBER_WEB=
QX_CF_CLEARANCE=
QX_CF_BM=

# Must match the browser that produced cf_clearance — Cloudflare binds the
# clearance cookie to the User-Agent that solved the challenge.
QX_UA=

# HTTP host for the refresh. Separate from QX_HOST on purpose: QX_HOST drives
# the WebSocket URL (wss://ws2.<host>/) and must not change.
# market-qx.trade 301s to market-qx.info, so both are listed.
QX_WEB_HOST=market-qx.info,market-qx.trade

QX_AUTO_REFRESH=1              # 0 = disable, back to manual token pasting
QX_REFRESH_PERIOD_HOURS=6      # proactive refresh cadence (token lives ~24h)
QX_REFRESH_MIN_INTERVAL=60     # floor between refresh attempts (seconds)
QX_STRICT_EMAIL=0              # 1 = refuse a session whose account != QX_EMAIL

# ─── OPTIONAL: Email/Password ───────────────────────────────────────────────
# QX_EMAIL is used to sanity-check which account the cookies belong to.
# Password login is a LAST resort and OFF by default: Cloudflare blocks the
# form POST from datacenter IPs, Quotex usually demands an e-mailed PIN code
# (which cannot be automated), and repeated attempts risk an account block.
# Cookies make it unnecessary.
QX_EMAIL=
QX_PASSWORD=
QX_ALLOW_PASSWORD_LOGIN=0
QX_LOGIN_MIN_INTERVAL=1800     # hard floor between login attempts (seconds)

# ─── BACKEND SELECTION ──────────────────────────────────────────────────────
# QX_USE_RAW_WS=0   # DEFAULT — vendored pyquotex with Firefox TLS cipher
#                   #            suite (bypasses Cloudflare without
#                   #            Playwright/curl_cffi). Recommended.
# QX_USE_RAW_WS=1   # raw WebSocket backend (quotex_ws.py) — lighter but
#                   #            Cloudflare blocks login on datacenter IPs.
QX_USE_RAW_WS=0

# ─── LIVE RE-EVAL (CALIBRATION-2026-07-29) ─────────────────────────────────
# Data analysis of 1,325 graded signals showed LIVE re-eval was the #1
# accuracy killer: 88% of signals had confidence reduced to 15 via
# "RECOVERED_CONFIDENCE" path, and these signals had only 43.3% win rate
# (vs 99%+ for non-recovered signals).
# QX_DISABLE_LIVE_REEVAL=1  # DEFAULT — disable LIVE re-eval (recommended)
# QX_DISABLE_LIVE_REEVAL=0  # enable LIVE re-eval (legacy behavior, NOT recommended)
QX_DISABLE_LIVE_REEVAL=1

# ─── PAYOUT FLOORS ──────────────────────────────────────────────────────────
# Real forex market: open 5 days/week (Mon-Fri). Closed Sat/Sun.
# OTC pairs: open 24/7/365 (broker-generated, always live).
# Real pairs below 70% payout are filtered out; OTC pairs below 85% are filtered.
QX_PAYOUT_FLOOR_REAL=70
QX_PAYOUT_FLOOR_OTC=85

# ─── DEPLOYMENT MODE (Railway) ──────────────────────────────────────────────
# Railway has no GUI — these must be set.
AUTO_OPEN_BROWSER=0
HEADLESS=1

# ─── RAILWAY AUTO-SETUP (optional) ──────────────────────────────────────────
# These are used by scripts/setup_railway_token.py to programmatically
# push a fresh QX_TOKEN to Railway Variables (instead of clicking the dashboard).
# Get the API token from: https://railway.app/account/tokens
# Run `python3 scripts/setup_railway_token.py --list` to find project/service IDs.
# RAILWAY_API_TOKEN=
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
# RAILWAY_ENVIRONMENT_ID=

# ─── TELEGRAM ALERTS (optional, LIVE-TICK-RELIABILITY-2026-07-31) ──────────
# QX_TOKEN expires ~24h and previously died with ZERO notification -- the
# only way to notice was to manually check /api/token-status or watch the
# chart go stale. Set these two to get a Telegram message the moment the
# token dies (push a new one via /api/set-token) and again when it recovers.
# Setup:
#   1. Talk to @BotFather on Telegram -> /newbot -> copy the bot token.
#   2. Message your new bot once, then open:
#      https://api.telegram.org/bot<TOKEN>/getUpdates
#      and read "chat":{"id": ...} from the JSON for your chat id.
# Leave both blank to disable -- alerts.py no-ops safely either way.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
